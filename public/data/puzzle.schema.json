{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "puzzle.schema.json",
  "title": "Links – daily puzzle",
  "description": "One puzzle per file: public/data/puzzles/easy/YYYY-MM-DD.json (Easy) or public/data/puzzles/hard/YYYY-MM-DD.json (Hard). The file name must match the \"date\" field.",
  "type": "object",
  "required": ["id", "date", "categories"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "minLength": 1, "description": "Unique puzzle id across both modes, e.g. \"hard-2026-09-25\"." },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Publication date (YYYY-MM-DD)." },
    "author": { "type": "string" },
    "categories": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "description": "Exactly 4 categories, one per difficulty colour.",
      "items": {
        "type": "object",
        "required": ["id", "name", "difficulty", "words"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1, "description": "Shown on the solved row." },
          "difficulty": { "enum": ["yellow", "green", "blue", "purple"] },
          "words": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
